---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

// TODO: public/gallery/ 에 이미지를 넣고 아래 배열을 채우세요.
// 예: { src: "/gallery/2026-mt.jpg", caption: "2026 여름 워크숍" }
const photos: { src: string; caption: string }[] = [];
---

<BaseLayout title="Gallery" description="MI Lab 갤러리">
  <PageHeader title="Gallery" subtitle="갤러리" />

  {
    photos.length === 0 ? (
      <p class="rounded-xl border border-dashed border-slate-300 p-10 text-center text-slate-400">
        준비 중입니다.
      </p>
    ) : (
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {photos.map((p) => (
          <li class="overflow-hidden rounded-xl border border-slate-200">
            <img src={p.src} alt={p.caption} class="aspect-4/3 w-full object-cover" />
            <p class="p-3 text-sm text-slate-600">{p.caption}</p>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
