---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PaperList from "../components/PaperList.astro";
import { bibToPapers } from "../lib/bibtex";
import publicationsBib from "../data/publications.bib?raw";
import preprintsBib from "../data/preprints.bib?raw";

// 논문 목록은 src/data/*.bib 를 수정하면 자동 반영됩니다.
const publications = bibToPapers(publicationsBib);
const preprints = bibToPapers(preprintsBib);
---

<BaseLayout title="Paper" description="MI Lab 논문 목록">
  <PageHeader title="Paper" />

  <section class="mb-14">
    <h2 class="mb-5 text-lg font-bold text-slate-900">
      Publication <span class="font-normal">(including workshop)</span>
    </h2>
    <PaperList papers={publications} />
  </section>

  <section>
    <h2 class="mb-5 text-lg font-bold text-slate-900">Preprint</h2>
    <PaperList papers={preprints} />
  </section>
</BaseLayout>
