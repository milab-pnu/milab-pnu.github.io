---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../consts";
---

<BaseLayout title="404" description="페이지를 찾을 수 없습니다">
  <div class="py-16 text-center">
    <p class="text-5xl font-extrabold tracking-tight text-slate-300">404</p>
    <h1 class="mt-4 text-xl font-bold text-slate-900">
      페이지를 찾을 수 없습니다
    </h1>
    <p class="mt-2 text-slate-500">주소가 바뀌었거나 삭제된 페이지일 수 있습니다.</p>
    <a
      class="mt-6 inline-block text-sm font-medium text-indigo-600 hover:underline"
      href={withBase("/")}
    >
      ← 홈으로 돌아가기
    </a>
  </div>
</BaseLayout>
