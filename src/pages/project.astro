---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

const projects: {
  title: string;
  period: string;
  host: string;
  desc: string;
}[] = [
  {
    title: "시각적 근거 기반 추론이 가능한 비전-언어 모델을 활용한 산업 이미지의 논리적 이상 탐지",
    period: "2026.09-2028.08",
    host: "부산대학교",
    desc: "제품의 불량은 흠집이나 파손처럼 눈에 띄는 결함에만 한정되지 않습니다. 부품 하나하나는 정상이어도 개수가 맞지 않거나 잘못 연결되어 있으면 제품 전체는 불량이 될 수 있습니다. 본 연구는 인공지능이 부품의 상태와 관계를 살펴 이러한 논리적 이상을 찾아내고, 어떤 시각적 근거로 불량을 판단했는지 설명하도록 하는 데 목적이 있습니다. 이를 통해 사람이 판단의 이유를 확인할 수 있는 산업 검사 기술의 기반을 마련하고자 합니다.",
  },
  {
    title: "음성-언어 멀티모달 모델 기반 스트레스 발현 양상 분석",
    period: "2026.10-2027.09",
    host: "부산대학교",
    desc: "스트레스는 말의 내용뿐 아니라 목소리와 말투에도 드러날 수 있습니다. “괜찮다”고 말하면서도 목소리에서는 긴장이나 주저함이 나타나듯, 어느 한쪽만으로는 알아차리기 어려운 신호가 있습니다. 본 연구는 음성과 언어에 나타나는 단서를 함께 살펴 스트레스가 말에 어떻게 드러나는지 이해하고, 일상적인 대화에서 스트레스 상태를 파악하는 데 도움이 될 근거를 마련하고자 합니다.",
  },
];
---

<BaseLayout title="Project" description="MI Lab 연구 과제">
  <PageHeader title="Project" />

  <ul class="space-y-5">
    {
      projects.map((p) => (
        <li class="rounded-xl border border-slate-200 p-5 sm:p-6">
          <h2 class="text-base font-bold text-slate-900">{p.title}</h2>
          <dl class="mt-3 space-y-1 text-sm">
            <div class="flex gap-2">
              <dt class="w-5 shrink-0"><span aria-hidden="true">📅</span><span class="sr-only">기간</span></dt>
              <dd class="tabular-nums text-slate-700">{p.period}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="w-5 shrink-0"><span aria-hidden="true">🏛️</span><span class="sr-only">지원기관</span></dt>
              <dd class="text-slate-700">{p.host}</dd>
            </div>
          </dl>
          <p class="mt-3 border-t border-slate-100 pt-3 text-sm leading-relaxed text-slate-600">
            {p.desc}
          </p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
