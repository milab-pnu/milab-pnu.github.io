---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

// TODO: 실제 수행 과제로 교체. (과제가 늘어나면 content collection 으로 분리)
//  - title:  과제명
//  - period: 수행 기간
//  - host:   주체 (지원기관 / 주관기관 등)
//  - desc:   설명
const projects: {
  title: string;
  period: string;
  host: string;
  desc: string;
}[] = [
  {
    title: "멀티모달 파운데이션 모델의 신뢰성 향상을 위한 학습 기법 연구 (예시)",
    period: "2026.09 – 2029.08",
    host: "한국연구재단 (개인기초연구)",
    desc: "이미지·텍스트·음성을 함께 다루는 멀티모달 파운데이션 모델이 편향되거나 잘못된 출력을 내지 않도록, 데이터 이질성과 분포 변화에 강건한 사전학습·정렬 기법을 연구한다. (예시 과제이며 실제 내용으로 교체 예정)",
  },
];
---

<BaseLayout title="Project" description="MI Lab 연구 과제">
  <PageHeader title="Project" />

  <ul class="space-y-5">
    {
      projects.map((p) => (
        <li class="rounded-xl border border-slate-200 p-5 sm:p-6">
          <h2 class="text-base font-bold text-slate-900">{p.title}</h2>
          <dl class="mt-3 space-y-1 text-sm">
            <div class="flex gap-2">
              <dt class="w-14 shrink-0 font-medium text-slate-500">기간</dt>
              <dd class="tabular-nums text-slate-700">{p.period}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="w-14 shrink-0 font-medium text-slate-500">주체</dt>
              <dd class="text-slate-700">{p.host}</dd>
            </div>
          </dl>
          <p class="mt-3 border-t border-slate-100 pt-3 text-sm leading-relaxed text-slate-600">
            {p.desc}
          </p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
