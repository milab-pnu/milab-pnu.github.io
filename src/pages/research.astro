---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

// TODO: 연구 주제별 카드/설명으로 교체.
const topics = [
  {
    title: "신뢰 가능한 AI (Trustworthy AI)",
    desc: "불확실성 정량화, 강건성, 설명 가능성에 관한 연구 (예시).",
  },
  {
    title: "효율적 학습 (Efficient Learning)",
    desc: "데이터/연산 효율적인 표현 학습 및 최적화 (예시).",
  },
  {
    title: "응용 (Applications)",
    desc: "의료 영상, 시계열 등 실제 도메인 응용 (예시).",
  },
];
---

<BaseLayout title="Research" description="MI Lab 연구 주제">
  <PageHeader title="Research" subtitle="연구 주제" />

  <div class="prose-basic max-w-none">
    <p>
      연구실의 전반적인 연구 방향을 소개하는 문단(예시). 실제 내용으로 교체하세요.
    </p>
  </div>

  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {
      topics.map((t) => (
        <li class="rounded-xl border border-slate-200 p-5">
          <h2 class="font-bold text-slate-900">{t.title}</h2>
          <p class="mt-2 text-sm text-slate-600">{t.desc}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
