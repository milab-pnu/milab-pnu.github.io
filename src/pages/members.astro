---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import MemberCard from "../components/MemberCard.astro";
import ProfileList from "../components/ProfileList.astro";
import MemberLinks from "../components/MemberLinks.astro";
import { withBase } from "../consts";

const members = (await getCollection("members")).sort(
  (a, b) => a.data.order - b.data.order,
);

const professor = members.find((m) => m.data.role === "professor");
// 본문(마크다운)이 실제로 있을 때만 렌더 — 빈 본문이면 구분선만 남아서 제외
const ProfBody =
  professor && professor.body?.trim()
    ? (await render(professor)).Content
    : null;

const current = members.filter((m) => !m.data.alumni);
// role enum(professor/postdoc/phd/ms/undergrad) 을 빠짐없이 커버해야 함 —
// 어느 그룹에도 안 걸리면 그 구성원은 페이지에서 사라짐
const GROUPS: { label: string; roles: string[] }[] = [
  { label: "Postdoctoral Researchers", roles: ["postdoc"] },
  { label: "Ph.D. Students", roles: ["phd"] },
  { label: "M.S. Students", roles: ["ms"] },
  { label: "Undergraduate Students", roles: ["undergrad"] },
];
---

<BaseLayout title="Members" description="MI Lab 구성원">
  <PageHeader title="Members" />

  {
    professor && (
      <section class="mb-12">
        <h2 class="mb-4 text-lg font-bold text-slate-900">Supervisor</h2>
        <div class="rounded-xl border border-slate-200 p-5 sm:p-6">
          <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
            {professor.data.photo ? (
              <img
                src={withBase(professor.data.photo)}
                alt={professor.data.name}
                class="h-28 w-24 shrink-0 rounded-xl object-cover"
              />
            ) : (
              <div class="flex h-28 w-24 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-400">
                <span class="text-2xl font-bold">{professor.data.name.at(0)}</span>
              </div>
            )}
            <div class="min-w-0 flex-1">
              <p class="text-xl font-bold text-slate-900">
                {professor.data.name}
                {professor.data.nameEn && (
                  <span class="ml-2 text-base font-normal text-slate-500">
                    {professor.data.nameEn}
                  </span>
                )}
              </p>
              {professor.data.title && (
                <p class="mt-1 text-sm text-slate-600">{professor.data.title}</p>
              )}
              {professor.data.email && (
                <p class="mt-1 text-sm">
                  <a
                    class="text-slate-700 underline decoration-slate-400 underline-offset-2 hover:decoration-slate-900"
                    href={`mailto:${professor.data.email}`}
                  >
                    {professor.data.email}
                  </a>
                </p>
              )}
              <MemberLinks
                name={professor.data.name}
                homepage={professor.data.homepage}
                links={professor.data.links}
              />
            </div>
          </div>

          {ProfBody && (
            <div class="prose-basic mt-5 max-w-none border-t border-slate-200 pt-5 text-slate-700">
              <ProfBody />
            </div>
          )}

          <ProfileList heading="Education" items={professor.data.education} />
          <ProfileList
            heading="Work History"
            items={professor.data.workHistory}
          />
        </div>
      </section>
    )
  }

  {
    GROUPS.map((group) => {
      const list = current.filter((m) => group.roles.includes(m.data.role));
      return (
        <section class="mb-12">
          <h2 class="mb-4 text-lg font-bold text-slate-900">{group.label}</h2>
          {list.length > 0 ? (
            <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {list.map((m) => (
                <MemberCard member={m} />
              ))}
            </ul>
          ) : (
            <p class="text-sm text-slate-500">—</p>
          )}
        </section>
      );
    })
  }
</BaseLayout>
