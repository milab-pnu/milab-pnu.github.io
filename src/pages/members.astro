---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import MemberCard from "../components/MemberCard.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../consts";

const members = (await getCollection("members")).sort(
  (a, b) => a.data.order - b.data.order,
);

/** 외부 링크 url 로 아이콘 종류 판별 */
function iconFor(url: string): "scholar" | "linkedin" | "github" | "link" {
  if (/scholar\.google\./.test(url)) return "scholar";
  if (/linkedin\.com/.test(url)) return "linkedin";
  if (/github\.com/.test(url)) return "github";
  return "link";
}

const professor = members.find((m) => m.data.role === "professor");
const ProfBody = professor ? (await render(professor)).Content : null;

const current = members.filter((m) => !m.data.alumni);
const GROUPS: { label: string; roles: string[] }[] = [
  { label: "Ph.D. Students", roles: ["phd"] },
  { label: "M.S. Students", roles: ["ms"] },
  { label: "Undergraduate Students", roles: ["undergrad"] },
];
---

<BaseLayout title="Members" description="MI Lab 구성원">
  <PageHeader title="Members" />

  {
    professor && (
      <section class="mb-16">
        <h2 class="mb-4 text-lg font-bold text-slate-900">Professor</h2>
        <div class="rounded-2xl border border-slate-200 p-6 sm:p-8">
          <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
            {professor.data.photo ? (
              <img
                src={withBase(professor.data.photo)}
                alt={professor.data.name}
                class="h-32 w-32 shrink-0 rounded-2xl object-cover"
              />
            ) : (
              <div class="flex h-32 w-32 shrink-0 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
                <span class="text-3xl font-bold">{professor.data.name.at(0)}</span>
              </div>
            )}
            <div class="min-w-0 flex-1">
              <p class="text-2xl font-bold text-slate-900">
                {professor.data.name}
                {professor.data.nameEn && (
                  <span class="ml-2 text-lg font-normal text-slate-400">
                    {professor.data.nameEn}
                  </span>
                )}
              </p>
              {professor.data.title && (
                <p class="mt-1 text-slate-600">{professor.data.title}</p>
              )}
              {professor.data.interests.length > 0 && (
                <p class="mt-2 text-sm text-slate-500">
                  {professor.data.interests.join(" · ")}
                </p>
              )}
              <div class="mt-3 flex items-center gap-3 text-slate-400">
                {professor.data.email && (
                  <a
                    class="hover:text-indigo-600"
                    href={`mailto:${professor.data.email}`}
                    aria-label={`${professor.data.name} 이메일`}
                  >
                    <Icon name="mail" class="h-5 w-5" />
                  </a>
                )}
                {professor.data.homepage && (
                  <a
                    class="hover:text-indigo-600"
                    href={professor.data.homepage}
                    target="_blank"
                    rel="noopener"
                    aria-label={`${professor.data.name} 홈페이지`}
                  >
                    <Icon name="link" class="h-5 w-5" />
                  </a>
                )}
                {professor.data.links.map((l) => (
                  <a
                    class="hover:text-indigo-600"
                    href={l.url}
                    target="_blank"
                    rel="noopener"
                    aria-label={`${professor.data.name} ${l.label}`}
                    title={l.label}
                  >
                    <Icon name={iconFor(l.url)} class="h-5 w-5" />
                  </a>
                ))}
              </div>
            </div>
          </div>

          {ProfBody && (
            <div class="prose-basic mt-6 max-w-none border-t border-slate-200 pt-6 text-slate-700">
              <ProfBody />
            </div>
          )}

          {professor.data.education.length > 0 && (
            <div class="mt-6 border-t border-slate-200 pt-6">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                Education
              </h3>
              <ul class="mt-2 space-y-1 text-sm text-slate-700">
                {professor.data.education.map((e) => (
                  <li>{e}</li>
                ))}
              </ul>
            </div>
          )}

          {professor.data.workHistory.length > 0 && (
            <div class="mt-6 border-t border-slate-200 pt-6">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                Work History
              </h3>
              <ul class="mt-2 space-y-1 text-sm text-slate-700">
                {professor.data.workHistory.map((w) => (
                  <li>{w}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    GROUPS.map((group) => {
      const list = current.filter((m) => group.roles.includes(m.data.role));
      if (list.length === 0) return null;
      return (
        <section class="mb-12">
          <h2 class="mb-4 text-lg font-bold text-slate-900">{group.label}</h2>
          <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {list.map((m) => (
              <MemberCard member={m} />
            ))}
          </ul>
        </section>
      );
    })
  }
</BaseLayout>
