---
import { getCollection, render } from "astro:content";
import NoteLayout from "../../../layouts/NoteLayout.astro";
import Sidenote from "../../../components/lecture/Sidenote.astro";
import Figure from "../../../components/lecture/Figure.astro";
import Video from "../../../components/lecture/Video.astro";
import Callout from "../../../components/lecture/Callout.astro";
import Details from "../../../components/lecture/Details.astro";

// weeks/*.mdx 에서 import 없이 쓰는 컴포넌트 — 여기서 주입한다.
// (계약: docs/lecture-authoring.md 의 "강의 노트 컴포넌트" 목록과 일치)
// 인용은 컴포넌트가 아니라 GFM 각주(`본문[^키]` + `[^키]: …`)를 쓴다.
const mdxComponents = {
  Sidenote,
  Figure,
  Video,
  Callout,
  Details,
};

export async function getStaticPaths() {
  const [notes, courses] = await Promise.all([
    getCollection("lectureNotes"),
    getCollection("courses"),
  ]);
  return notes.map((note) => {
    const parts = note.id.split("/");
    const courseSlug = parts[0];
    const noteSlug = parts.slice(2).join("/");
    const course = courses.find((c) => c.id.split("/")[0] === courseSlug);
    return {
      params: { course: courseSlug, note: noteSlug },
      props: {
        note,
        courseSlug,
        courseTitle: course?.data.title ?? courseSlug,
      },
    };
  });
}

const { note, courseSlug, courseTitle } = Astro.props;
const { Content, headings } = await render(note);
---

<NoteLayout
  title={note.data.title}
  courseTitle={courseTitle}
  courseSlug={courseSlug}
  week={note.data.week}
  headings={headings}
>
  <Content components={mdxComponents} />
</NoteLayout>
