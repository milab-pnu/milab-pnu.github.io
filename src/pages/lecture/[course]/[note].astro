---
import { getCollection, render } from "astro:content";
import NoteLayout from "../../../layouts/NoteLayout.astro";

export async function getStaticPaths() {
  const [notes, courses] = await Promise.all([
    getCollection("lectureNotes"),
    getCollection("courses"),
  ]);
  return notes.map((note) => {
    const parts = note.id.split("/");
    const courseSlug = parts[0];
    const noteSlug = parts.slice(2).join("/");
    const course = courses.find((c) => c.id.split("/")[0] === courseSlug);
    return {
      params: { course: courseSlug, note: noteSlug },
      props: {
        note,
        courseSlug,
        courseTitle: course?.data.title ?? courseSlug,
      },
    };
  });
}

const { note, courseSlug, courseTitle } = Astro.props;
const { Content } = await render(note);
---

<NoteLayout
  title={note.data.title}
  courseTitle={courseTitle}
  courseSlug={courseSlug}
  week={note.data.week}
>
  <Content />
</NoteLayout>
