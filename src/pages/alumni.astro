---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import MemberGroups from "../components/MemberGroups.astro";

const members = (await getCollection("members")).sort(
  (a, b) => a.data.order - b.data.order,
);
const alumni = members.filter((m) => m.data.alumni);

const GROUPS: { label: string; roles: string[] }[] = [
  { label: "Ph.D.", roles: ["phd"] },
  { label: "M.S.", roles: ["ms"] },
];
---

<BaseLayout title="Alumni" description="MI Lab 졸업생">
  <PageHeader title="Alumni" />

  <MemberGroups members={alumni} groups={GROUPS} />
</BaseLayout>
