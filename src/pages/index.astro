---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsList from "../components/NewsList.astro";
import NewsPager from "../components/NewsPager.astro";
import { SITE, withBase } from "../consts";
import { getSortedNews, newsTotalPages, NEWS_PAGE_SIZE } from "../lib/news";

const news = await getSortedNews();
const pageItems = news.slice(0, NEWS_PAGE_SIZE);
const totalPages = newsTotalPages(news.length);

const labIntroUrl = withBase("/lab-intro");
const applyFormUrl = "https://forms.gle/22wivoxpYEken8qd9";
---

<BaseLayout>
  <!-- Hero / Welcome -->
  <section class="mb-16">
    <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">
      {SITE.orgKo} {SITE.deptKo}
    </p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
      {SITE.fullName}
    </h1>
  </section>

  <!-- Recruitment -->
  <section class="mb-16 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
    <h2 class="text-xl font-bold text-slate-900">구성원 모집</h2>
    <p class="mt-3 leading-relaxed text-slate-600">
      멀티모달 인공지능 연구에 관심있는 학부생과 대학원생의 지원을 환영합니다.{" "}
      <a class="font-medium text-slate-900 underline decoration-slate-400 underline-offset-2 hover:decoration-slate-900" href={labIntroUrl}>[연구실 소개 자료]</a>{" "}
      <a class="font-medium text-slate-900 underline decoration-slate-400 underline-offset-2 hover:decoration-slate-900" href={applyFormUrl} target="_blank" rel="noopener">[지원서]</a>
    </p>
    <p class="mt-3 text-sm font-medium text-slate-500">
      현재는 신규 구성원을 모집하고 있지 않습니다.
    </p>
    <p class="mt-3 text-sm text-slate-600">
      지원서 제출처:{" "}
      <a class="text-slate-900 underline decoration-slate-400 underline-offset-2 hover:decoration-slate-900" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
  </section>

  <!-- Latest News -->
  <section>
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="text-xl font-bold text-slate-900">최신 뉴스</h2>
    </div>
    <NewsList items={pageItems} />
    <NewsPager currentPage={1} totalPages={totalPages} />
  </section>
</BaseLayout>
