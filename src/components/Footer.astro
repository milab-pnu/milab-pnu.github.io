---
import { SITE } from "../consts";
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-5xl px-4 py-10 text-sm text-slate-500">
    <p class="font-semibold text-slate-700">{SITE.fullName} ({SITE.name})</p>
    <p class="mt-1">{SITE.orgKo} · {SITE.org}</p>
    <p class="mt-1">
      문의: <a class="underline hover:text-slate-700" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
    <p class="mt-4 text-xs text-slate-400">© {year} {SITE.name}. All rights reserved.</p>
  </div>
</footer>
