---
import type { CollectionEntry } from "astro:content";
import MemberLinks from "./MemberLinks.astro";
import Icon from "./Icon.astro";
import { withBase } from "../consts";

interface Props {
  member: CollectionEntry<"members">;
}
const { member } = Astro.props;
const m = member.data;
---

<li class="rounded-xl border border-slate-200 p-4">
  <div class="flex items-start gap-3">
    {
      m.photo ? (
        <img
          src={withBase(m.photo)}
          alt={m.name}
          width="80"
          height="96"
          loading="lazy"
          decoding="async"
          class="h-24 w-20 shrink-0 rounded-lg object-cover"
        />
      ) : (
        <div class="flex h-24 w-20 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-300">
          <Icon name="user" class="h-10 w-10" />
        </div>
      )
    }
    <div class="min-w-0">
      <p class="font-semibold text-slate-900">
        {m.name}
        {m.nameEn && (
          <span class="ml-1 text-sm font-normal text-slate-500">{m.nameEn}</span>
        )}
      </p>
      {m.title && <p class="text-sm text-slate-500">{m.title}</p>}
      {
        m.email && (
          <p class="mt-1 text-xs">
            <a class="text-slate-600 underline decoration-slate-300 underline-offset-2 hover:decoration-slate-700" href={`mailto:${m.email}`}>
              {m.email}
            </a>
          </p>
        )
      }
      <MemberLinks name={m.name} homepage={m.homepage} links={m.links} />
    </div>
  </div>
</li>
