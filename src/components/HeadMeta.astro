---
// <head> 공통 메타 — BaseLayout(사이트 크롬 있음)과 NoteLayout(강의 노트, 크롬 없음)이 공유.
// CSP 는 여기 한 곳에서만 관리한다.
import { withBase, SITE } from "../consts";

// 기본값 = 엄격 CSP (런타임 JS·인라인 스타일 없는 대부분의 페이지).
// 강의 노트 페이지는 NoteLayout 이 완화값을 csp prop 으로 넘긴다.
const STRICT_CSP =
  "default-src 'self'; script-src 'none'; style-src 'self'; " +
  "img-src 'self' data:; font-src 'self' data:; " +
  "base-uri 'none'; form-action 'none'; object-src 'none'";

interface Props {
  title: string; // <title> 에 그대로 들어감
  description?: string;
  csp?: string;
}
const { title, description = SITE.description, csp = STRICT_CSP } = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{/* GitHub Pages 는 HTTP 헤더 불가 → meta 로. nginx 이전 시 실제 헤더 +
    frame-ancestors 로 강화. 기본은 엄격(script-src 'none'); 강의 노트 페이지만
    NoteLayout 이 완화 CSP 를 csp prop 으로 넘긴다 (번들 스크립트·외부 이미지·임베드). */}
<meta http-equiv="Content-Security-Policy" content={csp} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
<link rel="icon" href={withBase("/favicon.ico")} sizes="any" />
<title>{title}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
{canonical && <meta property="og:url" content={canonical} />}
