---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<div class="mb-10 border-b border-slate-200 pb-5">
  <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">{title}</h1>
  {subtitle && <p class="mt-2 text-slate-500">{subtitle}</p>}
</div>
