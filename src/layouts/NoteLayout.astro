---
// 주차별 강의 노트 전용 레이아웃 — 사이트 네비/푸터 없음(강의 자료는 MI Lab 크롬 없이
// 읽기 중심의 독립 문서로). 맨 아래에 강의 일정으로 돌아가는 작은 링크만.
import "../styles/global.css";
import HeadMeta from "../components/HeadMeta.astro";
import { withBase } from "../consts";

interface Props {
  title: string;
  courseTitle: string;
  courseSlug: string;
  week: number;
  description?: string;
}
const { title, courseTitle, courseSlug, week, description } = Astro.props;
const courseHref = withBase(`/lecture/${courseSlug}`);
---

<!doctype html>
<html lang="ko">
  <head>
    <HeadMeta
      title={`${title} · ${courseTitle}`}
      description={description ?? `${courseTitle} — ${title}`}
    />
  </head>
  <body class="bg-white text-slate-800">
    <article class="mx-auto max-w-2xl px-6 py-14 sm:py-20">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">
        Week {week}
      </p>
      <h1
        class="mt-2 text-4xl font-extrabold leading-[1.15] tracking-tight text-slate-900"
      >
        {title}
      </h1>

      <div class="prose-lecture mt-10">
        <slot />
      </div>
    </article>

    <footer class="mx-auto max-w-2xl px-6 pb-20">
      <div class="border-t border-slate-100 pt-6">
        <a class="text-sm text-indigo-600 hover:underline" href={courseHref}>
          ← 전체 일정
        </a>
      </div>
    </footer>
  </body>
</html>
